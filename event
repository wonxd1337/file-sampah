-- LOGIKA TOMBOL TOGGLE (DEFAULT ON)
-- ==========================================
local scriptEnabled = true

toggleButton.MouseButton1Click:Connect(function()
    scriptEnabled = not scriptEnabled
    if scriptEnabled then
        toggleButton.Text = "Status: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 50)
    else
        toggleButton.Text = "Status: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        RunService:Set3dRenderingEnabled(true)
    end
end)

-- ==========================================
-- LOGIKA UTAMA MONITOR EVENT & TELEPORT
-- ==========================================
local success, Replion = pcall(function()
    return require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Replion"))
end)

if success and Replion then
    local serverBrowserReplion = Replion.Client:WaitReplion("ServerBrowser")
    local lastTeleportedEvent = nil
    local savedReturnPosition = nil

    task.spawn(function()
        while true do
            if not scriptEnabled then
                task.wait(1)
            else
                pcall(function()
                    if serverBrowserReplion and serverBrowserReplion.Data and serverBrowserReplion.Data.Servers then
                        local currentServerData = serverBrowserReplion.Data.Servers[game.JobId]
                        
                        if currentServerData and currentServerData.Events and type(currentServerData.Events) == "table" then
                            local eventFound = false
                            
                            for _, activeEvent in ipairs(currentServerData.Events) do
                                if EventSpots[activeEvent] then
                                    eventFound = true
                                    if lastTeleportedEvent ~= activeEvent then
                                        local character = LocalPlayer.Character
                                        if character and character:FindFirstChild("HumanoidRootPart") then
                                            if not savedReturnPosition then
                                                savedReturnPosition = character.HumanoidRootPart.CFrame
                                            end
                                            RunService:Set3dRenderingEnabled(false)
                                            character.HumanoidRootPart.CFrame = EventSpots[activeEvent]
                                            lastTeleportedEvent = activeEvent
                                        end
                                    end
                                    break
                                end
                            end
                            
                            if not eventFound and lastTeleportedEvent ~= nil then
                                local character = LocalPlayer.Character
                                if character and character:FindFirstChild("HumanoidRootPart") and savedReturnPosition then
                                    character.HumanoidRootPart.CFrame = savedReturnPosition
                                end
                                RunService:Set3dRenderingEnabled(true)
                                lastTeleportedEvent = nil
                                savedReturnPosition = nil
                            end
                        end
                    end
                end)
                task.wait(5)
            end
        end
    end)
end
