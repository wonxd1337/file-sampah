-- ============================================================
-- HTTP HELPERS
-- ============================================================
local function apiGet(action, extraParams)
    local url = API_URL .. "?action=" .. action .. "&username=" .. HttpService:UrlEncode(USERNAME)
    if extraParams then
        for k, v in pairs(extraParams) do
            url = url .. "&" .. tostring(k) .. "=" .. HttpService:UrlEncode(tostring(v))
        end
    end
    local ok, result = pcall(function()
        return HttpService:GetAsync(url, true)
    end)
    if ok and result then
        local ok2, data = pcall(function() return HttpService:JSONDecode(result) end)
        if ok2 then return data end
    end
    return nil
end

local function apiPost(action, data)
    local body = HttpService:JSONEncode(data)
    local ok, result = pcall(function()
        return HttpService:PostAsync(
            API_URL .. "?action=" .. action,
            body,
            Enum.HttpContentType.ApplicationJson
        )
    end)
    if ok and result then
        local ok2, decoded = pcall(function() return HttpService:JSONDecode(result) end)
        if ok2 then return decoded end
    end
    return nil
end

-- ============================================================
-- AMBIL TRADE CONFIG DARI WEB
-- ============================================================
local function getTradeConfig()
    local data = apiGet("get_trade_config")
    if data and data.status == "ok" then
        return {
            auto_accept    = data.auto_accept == true,
            selected_uuids = data.selected_uuids or {}
        }
    end
    return { auto_accept = false, selected_uuids = {} }
end

-- ============================================================
-- DUMP INVENTORY KE WEB
-- ============================================================
local function dumpInventory()
    print("[AUTO TRADE] Memulai dump inventory ke web...")

    local okReplion, Replion = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Replion"))
    end)
    local okItemUtil, ItemUtility = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemUtility"))
    end)

    if not okReplion or not okItemUtil then
        warn("[AUTO TRADE] Gagal memuat modul untuk dump inventory")
        return
    end

    local playerData = Replion.Client:WaitReplion("Data")
    if not playerData then
        warn("[AUTO TRADE] Gagal mendapatkan player data")
        return
    end

    local inventory = playerData:Get("Inventory")
    if not inventory then
        warn("[AUTO TRADE] Inventory tidak ditemukan")
        return
    end

    local items = {}

    for categoryName, categoryItems in pairs(inventory) do
        if type(categoryItems) == "table" then
            for _, itemData in ipairs(categoryItems) do
                if itemData and itemData.UUID then
                    local okItem, itemInfo = pcall(function()
                        return ItemUtility.GetItemDataFromItemType(categoryName, itemData.Id)
                    end)
                    if okItem and itemInfo and itemInfo.Data then
                        local meta = itemData.Metadata or {}
                        table.insert(items, {
                            uuid        = tostring(itemData.UUID),
                            id          = tostring(itemData.Id or ""),
                            name        = tostring(itemInfo.Data.Name or "Unknown"),
                            type        = tostring(itemInfo.Data.Type or categoryName),
                            icon        = tostring(itemInfo.Data.Icon or ""),
                            weight      = meta.Weight  and tonumber(meta.Weight)  or nil,
                            mutation    = meta.Mutation and tostring(meta.Mutation) or nil,
                            rarity      = tostring(itemInfo.Data.Rarity or "Common"),
                            trade_locked = itemData.TradeLocked == true
                        })
                    end
                end
            end
        end
    end

    print(string.format("[AUTO TRADE] Mengirim %d item ke web...", #items))
    local res = apiPost("store_inventory", { username = USERNAME, items = items })
    if res and res.status == "ok" then
        print(string.format("[AUTO TRADE] âœ” Inventory berhasil dikirim! (%d item)", res.count or #items))
    else
        warn("[AUTO TRADE] âœ˜ Gagal mengirim inventory")
    end
end

