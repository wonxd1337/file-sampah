local okTradeData, TradeData = pcall(function()
    return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Trading"):WaitForChild("TradeData"))
end)

if not okTradeData or not TradeData or not TradeData.Remotes then
    warn("[AUTO TRADE] Gagal memuat TradeData!")
    return
end

local Remotes = TradeData.Remotes
local Replion = require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Replion"))
local ItemUtility = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemUtility"))

-- ============================================================
-- HANDLER: TRADE REQUEST DITERIMA
-- ============================================================
if Remotes.TradeOfferReceived then
    Remotes.TradeOfferReceived.OnClientEvent:Connect(function(sender)
        local config = getTradeConfig()
        local senderName = tostring(sender)
        print("[AUTO TRADE] Trade request dari: " .. senderName .. " | Auto Accept: " .. tostring(config.auto_accept))

        -- Laporkan ke web
        apiPost("update_trade_status", {
            username  = USERNAME,
            status    = "request_pending",
            requester = senderName
        })

        if config.auto_accept then
            pcall(function()
                Remotes.AcceptTradeOffer:InvokeServer(sender)
            end)
        end
    end)
end

-- ============================================================
-- HANDLER: SESI TRADE DIMULAI
-- ============================================================
if Remotes.TradeStarted then
    Remotes.TradeStarted.OnClientEvent:Connect(function(sessionId)
        -- Cek toggle
        local config = getTradeConfig()
        if not config.auto_accept then
            print("[AUTO TRADE] Trade session aktif tapi toggle OFF â€” skip.")
            apiPost("update_trade_status", { username = USERNAME, status = "idle", requester = "" })
            return
        end

        print("[AUTO TRADE] Sesi trade terbuka. SessionID: " .. tostring(sessionId))
        apiPost("update_trade_status", { username = USERNAME, status = "in_trade", requester = "" })

        task.spawn(function()
            task.wait(0.6)

            local sessionReplion = Replion.Client:WaitReplion(sessionId)
            local playerData     = Replion.Client:WaitReplion("Data")

            if not playerData then
                warn("[AUTO TRADE] Gagal membaca Player Data.")
                apiPost("update_trade_status", { username = USERNAME, status = "idle", requester = "" })
                return
            end

            local inventory = playerData:Get("Inventory")
            if not inventory then
                warn("[AUTO TRADE] Inventory tidak ditemukan.")
                apiPost("update_trade_status", { username = USERNAME, status = "idle", requester = "" })
                return
            end

            -- Build lookup: UUID â†’ {Type, UUID}
            local tradableByUUID = {}
            local allTradable    = {}

            for categoryName, categoryItems in pairs(inventory) do
                if type(categoryItems) == "table" then
                    for _, itemData in ipairs(categoryItems) do
                        if itemData and itemData.UUID and not itemData.TradeLocked then
                            local okItem, itemInfo = pcall(function()
                                return ItemUtility.GetItemDataFromItemType(categoryName, itemData.Id)
                            end)
                            if okItem and itemInfo and itemInfo.Data and itemInfo.Data.Type then
                                local itemType = itemInfo.Data.Type
                                if TradeData.FollowTradeRules(itemInfo, itemData) then
                                    local entry = { Type = itemType, UUID = itemData.UUID }
                                    tradableByUUID[itemData.UUID] = entry
                                    table.insert(allTradable, entry)
                                end
                            end
                        end
                    end
                end
            end

            -- Tentukan item yang mau di-trade
            local chosenItems    = {}
            local selectedUUIDs  = config.selected_uuids or {}
            local MAX_ITEMS      = 20  -- Batas maksimum game

            if #selectedUUIDs > 0 then
                -- Prioritas: item yang dipilih dari web
                for _, uuid in ipairs(selectedUUIDs) do
                    if tradableByUUID[uuid] then
                        table.insert(chosenItems, tradableByUUID[uuid])
                        if #chosenItems >= MAX_ITEMS then break end
                    end
                end
                print(string.format("[AUTO TRADE] Menggunakan %d item dari pilihan web", #chosenItems))
            end

            -- Fallback: jika tidak ada pilihan web yang valid, pakai semua tradable
            if #chosenItems == 0 then
                for i = 1, math.min(MAX_ITEMS, #allTradable) do
                    table.insert(chosenItems, allTradable[i])
                end
                print(string.format("[AUTO TRADE] Fallback: menggunakan %d item pertama", #chosenItems))
            end

            if #chosenItems == 0 then
                warn("[AUTO TRADE] Tidak ada item tradable yang valid!")
                apiPost("update_trade_status", { username = USERNAME, status = "idle", requester = "" })
                return
            end

            -- Tambahkan item ke trade
            print(string.format("[AUTO TRADE] Memasukkan %d item ke trade...", #chosenItems))
            for _, item in ipairs(chosenItems) do
                local okAdd, errAdd = pcall(function()
                    return Remotes.AddItem:InvokeServer(item.Type, item.UUID)
                end)
                if okAdd then
                    print("[AUTO TRADE] âœ” Berhasil: " .. item.UUID)
                else
                    warn("[AUTO TRADE] âœ˜ Gagal: " .. tostring(errAdd))
                end
                task.wait(0.15)
            end

            -- Kirim sinyal Ready
            print("[AUTO TRADE] Mengirim sinyal Ready...")
            task.wait(0.4)
            pcall(function() Remotes.SetReady:InvokeServer(true) end)

            -- Tunggu PlayersReady dari akun utama
            print("[AUTO TRADE] Menunggu akun utama siap (PlayersReady)...")
            local startTime = tick()
            while task.wait(0.1) do
                if tick() - startTime > 35 then
                    print("[AUTO TRADE] Timeout menunggu PlayersReady.")
                    break
                end
                local okCheck, isReady = pcall(function()
                    return sessionReplion and sessionReplion.Data and sessionReplion.Data.PlayersReady
                end)
                if okCheck and isReady == true then
                    print("[AUTO TRADE] Akun utama sudah Ready!")
                    break
                end
            end

            -- Konfirmasi trade
            print("[AUTO TRADE] Mengirim ConfirmTrade...")
            task.wait(0.4)
            pcall(function() Remotes.ConfirmTrade:InvokeServer() end)

            print("[ðŸŽ‰] Trade selesai! Akun: " .. USERNAME)

            -- Update status web
            task.wait(2)
            apiPost("update_trade_status", { username = USERNAME, status = "done", requester = "" })
            task.wait(4)
            apiPost("update_trade_status", { username = USERNAME, status = "idle", requester = "" })
        end)
    end)
end

