                print("[AUTO TRADE] Prompt trade request â€” auto-accept (toggle ON)")
                return Promise.resolve(true)
            else
                print("[AUTO TRADE] Prompt trade request â€” ditolak (toggle OFF)")
            end
        end
        return oldFirePrompt(self, text, ...)
    end
    print("[âœ”] PromptController hook aktif!")
end

