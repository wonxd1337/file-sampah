local dragging, dragInput, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if minimized then
        minBtn.Text = "+"
        TweenService:Create(body, tweenInfo, {Size = UDim2.new(1, 0, 0, 0)}):Play()
        TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 220, 0, 32)}):Play()
    else
        minBtn.Text = "-"
        TweenService:Create(body, tweenInfo, {Size = UDim2.new(1, 0, 0, 73)}):Play()
        TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 220, 0, 105)}):Play()
    end
end)

local autoActive = false
toggleBtn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    if autoActive then
        TweenService:Create(toggleBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(45, 140, 75)}):Play()
        toggleBtn.Text = "Auto Deposit: ON"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        TweenService:Create(toggleBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(35, 35, 48)}):Play()
        toggleBtn.Text = "Auto Deposit: OFF"
        toggleBtn.TextColor3 = Color3.fromRGB(240, 100, 100)
    end
end)

task.spawn(function()
    local successReplion, Replion = pcall(function() return require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Replion")) end)
    local successConfig, StarConfig = pcall(function() return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("StarMachineConfig")) end)
    
    if not successReplion or not successConfig then
        timeLabel.Text = "Status: Error Config"
        return
    end

    local machineData = Replion.Client:WaitReplion(StarConfig.Channel)
    
    while true do
        local activeEndsAt = machineData:Get("ActiveEndsAt") or 0
        local serverTime = workspace:GetServerTimeNow()
        local timeLeft = activeEndsAt - serverTime
        
        if timeLeft > 0 then
            local hours = math.floor(timeLeft / 3600)
            local minutes = math.floor((timeLeft % 3600) / 60)
            local seconds = math.floor(timeLeft % 60)
            
            if hours > 0 then
                timeLabel.Text = string.format("Time Left: %d:%02d:%02d", hours, minutes, seconds)
            else
                timeLabel.Text = string.format("Time Left: %02d:%02d", minutes, seconds)
            end
            timeLabel.TextColor3 = Color3.fromRGB(160, 220, 180)
        else
            timeLabel.Text = "Status: Expired / Ready"
            timeLabel.TextColor3 = Color3.fromRGB(240, 100, 100)
        end
        
        if autoActive and timeLeft <= 0 then
            local machines = CollectionService:GetTagged(StarConfig.MachineTag)
            if #machines > 0 then
                local machine = machines[1]
                local promptPart = machine:FindFirstChild(StarConfig.Assets.PromptPart) or machine:FindFirstChild("PromptPart")
                
                if promptPart then
                    local prompt = promptPart:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then
                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        
                        if hrp then
                            local originalCFrame = hrp.CFrame
                            
                            hrp.CFrame = promptPart.CFrame + Vector3.new(0, 3, 2)
                            task.wait(1.0)
                            
                            for i = 1, 3 do
                                local chargeFragments = machineData:Get("ChargeFragments") or 0
                                if chargeFragments >= StarConfig.ActivationFragmentCost then
                                    break
                                end
                                
                                fireproximityprompt(prompt)
                                task.wait(0.7)
                            end
                            
                            task.wait(0.5)
                            hrp.CFrame = originalCFrame
                            task.wait(10)
                        end
                    end
                end
            end
        end
        
        task.wait(1)
    end
end)
